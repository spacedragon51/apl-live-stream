rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner(data) {
      return data.userId == request.auth.uid;
    }

    function isValidVote(data, pollId) {
      return data.keys().hasAll(['pollId', 'userId', 'optionIndex', 'timestamp'])
        && data.keys().size() == 4
        && data.pollId == pollId
        && data.userId == request.auth.uid
        && data.optionIndex is int
        && data.timestamp == request.time;
    }

    function isValidReaction(data, matchId) {
      return data.keys().hasAll(['matchId', 'emoji', 'userId', 'timestamp'])
        && data.keys().size() == 4
        && data.matchId == matchId
        && data.emoji is string
        && data.emoji.size() <= 10
        && data.userId == request.auth.uid
        && data.timestamp == request.time;
    }

    // Match rules
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
      
      match /polls/{pollId} {
        allow read: if true;
        allow write: if false;
        
        match /votes/{voteId} {
          allow create: if isSignedIn() 
            && isValidId(voteId)
            && isValidVote(incoming(), pollId);
          allow read: if isSignedIn();
        }
      }

      match /reactions/{reactionId} {
        allow create: if isSignedIn() 
          && isValidId(reactionId)
          && isValidReaction(incoming(), matchId);
        allow read: if true;
      }

      match /insights/{insightId} {
        allow read: if true;
        allow write: if false; // System only
      }
    }
  }
}
